# Copia este archivo como .env.local para sobrescribir valores en tu Mac.
# Todas son opcionales: si faltan, el sitio usa los valores por defecto
# de src/config/contact.js (Formspree y WhatsApp) y src/lib/analytics.js (GA4).

# ID del formulario de Formspree (formspree.io/f/<ID>)
VITE_FORMSPREE_ID=

# Número de WhatsApp con código de país, sin + ni espacios (ej. 52XXXXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Google Analytics 4 — formato: G-XXXXXXXXXX
# Obtenlo en: analytics.google.com → Admin → Flujos de datos → tu propiedad
VITE_GA_MEASUREMENT_ID=
